# ==============================================================================
# Friday AI Assistant Configuration Example
# Copy this file to .env and configure your values.
# ==============================================================================

# General Application Settings
PROJECT_NAME="Friday AI Assistant"
VERSION="1.0.0"

# Server Configuration
HOST="127.0.0.1"
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL with psycopg3 driver)
PRIMARY_DB="postgresql+psycopg://username:password@localhost:5432/assistant_db"

# LLM Provider Selection: "groq" or "ollama"
LLM_PROVIDER="groq"

# Groq Cloud LLM Configuration
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE=0.2

# Ollama Local LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="deepseek-r1:1.5b"
OLLAMA_TEMPERATURE=0.5

# Conversation History Limits
MAX_HISTORY_MESSAGES=10

# Text-to-Speech (Edge TTS) Configuration
TTS_VOICE="en-US-JennyNeural"
TTS_RATE="+17%"

# Speech-to-Text (Whisper) Configuration
WISPER_MODEL="base"
